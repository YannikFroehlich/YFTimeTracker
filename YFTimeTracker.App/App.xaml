            <!-- Signalfarbe: Knöpfe, Auswahl, Hervorhebung. Text darauf in YFOnAccentBrush. -->
            <Color x:Key="YFAccentColor">#FF6A2B</Color>
            <SolidColorBrush x:Key="YFAccentBrush" Color="{StaticResource YFAccentColor}" />
            <SolidColorBrush x:Key="YFOnAccentBrush" Color="#150B05" />
            <!-- Systemakzent der WinUI-Steuerelemente (Schalter, Auswahl, Fortschritt) auf die Signalfarbe statt des Windows-Akzents. -->
            <Color x:Key="SystemAccentColor">#FF6A2B</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7D45</Color>
            <Color x:Key="SystemAccentColorLight2">#FF9466</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB08C</Color>
            <Color x:Key="SystemAccentColorDark1">#E0551C</Color>
            <Color x:Key="SystemAccentColorDark2">#B8430F</Color>
            <Color x:Key="SystemAccentColorDark3">#8F320A</Color>
            <Color x:Key="YFAccentButtonHoverBorderColor">#FF8A57</Color>
            <Color x:Key="YFAccentButtonPressedBorderColor">#E0551C</Color>

            <!-- Profilfarben zum Auswählen; als gespeicherte Werte unverändert. -->
            <Color x:Key="YFBlueColor">#3182FF</Color>
            <Color x:Key="YFCyanColor">#2CE5F3</Color>
            <Color x:Key="YFPurpleColor">#8A4DFF</Color>
            <Color x:Key="YFGreenColor">#29E7A4</Color>
            <Color x:Key="YFRedColor">#FF5368</Color>
            <Color x:Key="YFDangerButtonHoverBorderColor">#FF7181</Color>
            <Color x:Key="YFDangerButtonPressedBorderColor">#E23F53</Color>

