<Application
    x:Class="YFTimeTracker.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="YFBackgroundColor">#050B16</Color>
            <Color x:Key="YFNavigationColor">#040912</Color>
            <Color x:Key="YFSurfaceColor">#091323</Color>
            <Color x:Key="YFSurfaceRaisedColor">#0C192B</Color>
            <Color x:Key="YFStrokeColor">#1B2B43</Color>
            <Color x:Key="YFStrokeBrightColor">#27518A</Color>
            <Color x:Key="YFTextColor">#F4F7FF</Color>
            <Color x:Key="YFMutedColor">#9AA8BF</Color>
            <Color x:Key="YFBlueColor">#3182FF</Color>
            <Color x:Key="YFCyanColor">#2CE5F3</Color>
            <Color x:Key="YFPurpleColor">#8A4DFF</Color>
            <Color x:Key="YFGreenColor">#29E7A4</Color>
            <Color x:Key="YFRedColor">#FF5368</Color>

            <SolidColorBrush x:Key="YFBackgroundBrush" Color="{StaticResource YFBackgroundColor}" />
            <SolidColorBrush x:Key="YFNavigationBrush" Color="{StaticResource YFNavigationColor}" />
            <SolidColorBrush x:Key="YFSurfaceBrush" Color="{StaticResource YFSurfaceColor}" />
            <SolidColorBrush x:Key="YFSurfaceRaisedBrush" Color="{StaticResource YFSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="YFStrokeBrush" Color="{StaticResource YFStrokeColor}" />
            <SolidColorBrush x:Key="YFStrokeBrightBrush" Color="{StaticResource YFStrokeBrightColor}" />
            <SolidColorBrush x:Key="YFTextBrush" Color="{StaticResource YFTextColor}" />
            <SolidColorBrush x:Key="YFMutedBrush" Color="{StaticResource YFMutedColor}" />
            <SolidColorBrush x:Key="YFBlueBrush" Color="{StaticResource YFBlueColor}" />
            <SolidColorBrush x:Key="YFCyanBrush" Color="{StaticResource YFCyanColor}" />
            <SolidColorBrush x:Key="YFPurpleBrush" Color="{StaticResource YFPurpleColor}" />
            <SolidColorBrush x:Key="YFGreenBrush" Color="{StaticResource YFGreenColor}" />
            <SolidColorBrush x:Key="YFRedBrush" Color="{StaticResource YFRedColor}" />

            <LinearGradientBrush x:Key="YFLogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#28E8F5" Offset="0" />
                <GradientStop Color="#347BFF" Offset="0.46" />
                <GradientStop Color="#9948FF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="YFCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C1A2D" Offset="0" />
                <GradientStop Color="#08111F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="YFBlueCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#102D68" Offset="0" />
                <GradientStop Color="#0A1730" Offset="0.62" />
                <GradientStop Color="#08111F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="YFPurpleCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2C1764" Offset="0" />
                <GradientStop Color="#10152B" Offset="0.62" />
                <GradientStop Color="#08111F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="YFCyanCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#063C4F" Offset="0" />
                <GradientStop Color="#0A1C2C" Offset="0.62" />
                <GradientStop Color="#08111F" Offset="1" />
            </LinearGradientBrush>

            <Style TargetType="Page">
                <Setter Property="Background" Value="{StaticResource YFBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource YFTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>

            <Style x:Key="YFCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource YFCardGradientBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource YFStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="YFSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource YFCardStyle}">
                <Setter Property="Background" Value="{StaticResource YFSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="YFPageTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource YFTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="YFSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource YFBlueBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="25" />
            </Style>

            <Style x:Key="YFMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource YFMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="YFCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource YFMutedTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="35" />
            </Style>

            <Style x:Key="YFButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource YFTextBrush}" />
                <Setter Property="Background" Value="#122039" />
                <Setter Property="BorderBrush" Value="{StaticResource YFStrokeBrightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="YFAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="#183E88" />
                <Setter Property="BorderBrush" Value="{StaticResource YFBlueBrush}" />
            </Style>

            <Style x:Key="YFOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="#091526" />
                <Setter Property="BorderBrush" Value="#315B91" />
            </Style>

            <Style x:Key="YFDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="#28101B" />
                <Setter Property="BorderBrush" Value="{StaticResource YFRedBrush}" />
                <Setter Property="Foreground" Value="#FF8794" />
            </Style>

            <Style x:Key="YFIconButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="YFTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#091526" />
                <Setter Property="BorderBrush" Value="{StaticResource YFStrokeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource YFTextBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource YFMutedBrush}" />
            </Style>

            <Style x:Key="YFListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
