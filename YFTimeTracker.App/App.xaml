            <SolidColorBrush x:Key="YFDangerButtonHoverBorderBrush" Color="{StaticResource YFDangerButtonHoverBorderColor}" />
            <SolidColorBrush x:Key="YFDangerButtonPressedBorderBrush" Color="{StaticResource YFDangerButtonPressedBorderColor}" />

            <!-- Mitgelieferte Schriften (SIL OFL, Lizenzen in Assets/Fonts): Archivo, schmale Archivo für Titel und Zahlen, JetBrains Mono. -->
            <FontFamily x:Key="YFBodyFontFamily">ms-appx:///Assets/Fonts/Archivo.ttf#Archivo</FontFamily>
            <FontFamily x:Key="YFDisplayFontFamily">ms-appx:///Assets/Fonts/ArchivoCondensed-ExtraBold.ttf#Archivo Condensed</FontFamily>
            <FontFamily x:Key="YFMonoFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Archivo.ttf#Archivo</FontFamily>
            <CornerRadius x:Key="YFCardCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="YFControlCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="YFChipCornerRadius">3</CornerRadius>

            <Style x:Key="YFMetricIconStyle" TargetType="Border">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{ThemeResource YFOutlineButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrightBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource YFControlCornerRadius}" />
            </Style>

            <Style TargetType="Page">
                <Setter Property="Background" Value="{ThemeResource YFBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource YFBodyFontFamily}" />
            </Style>

            <Style x:Key="YFCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource YFSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource YFCardCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="YFSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource YFCardStyle}">
                <Setter Property="Background" Value="{ThemeResource YFBackgroundBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="YFChipStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource YFChipCornerRadius}" />
                <Setter Property="Padding" Value="6,2" />
            </Style>

            <Style x:Key="YFChipTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource YFMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource YFMonoFontFamily}" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <Style x:Key="YFPageTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource YFDisplayFontFamily}" />
                <Setter Property="FontSize" Value="38" />
                <Setter Property="LineHeight" Value="40" />
            </Style>

            <Style x:Key="YFSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource YFSectionTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource YFDisplayFontFamily}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="CharacterSpacing" Value="15" />
            </Style>

            <Style x:Key="YFMutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource YFMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Kleine Beschriftungen über Kennzahlen: Monospace wie auf einer Zeitnahme-Tafel. -->
            <Style x:Key="YFCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource YFMutedTextStyle}">
                <Setter Property="FontFamily" Value="{StaticResource YFMonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <ControlTemplate x:Key="YFButtonNeutralTemplate" TargetType="Button">
                <Grid
                    x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Grid.BackgroundTransition>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonBorderBrushPointerOver}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundPressed}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonBorderBrushPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="YFAccentButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualStateGroup.Transitions>
                                <VisualTransition GeneratedDuration="0:0:0.12" />
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="HoverOverlay.Opacity" Value="0.08" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource YFAccentButtonHoverBorderBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="PressedOverlay.Opacity" Value="0.18" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource YFAccentButtonPressedBorderBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="HoverOverlay" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border x:Name="PressedOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}" />
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="YFDangerButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Grid.BackgroundTransition>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource YFDangerButtonHoverBackgroundBrush}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource YFDangerButtonHoverBorderBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource YFDangerButtonPressedBackgroundBrush}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{StaticResource YFDangerButtonPressedBorderBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="YFOutlineButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="RootGrid"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Grid.BackgroundTransition>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource YFOutlineButtonHoverBackgroundBrush}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonBorderBrushPointerOver}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource YFOutlineButtonPressedBackgroundBrush}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonBorderBrushPressed}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Opacity" Value="0.45" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="YFButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource YFBodyFontFamily}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="CornerRadius" Value="{StaticResource YFControlCornerRadius}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
                <Setter Property="Background" Value="{ThemeResource YFButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template" Value="{StaticResource YFButtonNeutralTemplate}" />
            </Style>

            <Style x:Key="YFAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="{StaticResource YFAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource YFAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource YFOnAccentBrush}" />
                <Setter Property="Template" Value="{StaticResource YFAccentButtonTemplate}" />
            </Style>

            <Style x:Key="YFOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource YFOutlineButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrightBrush}" />
                <Setter Property="Template" Value="{StaticResource YFOutlineButtonTemplate}" />
            </Style>

            <Style x:Key="YFDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource YFDangerButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFDangerTextBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YFDangerTextBrush}" />
                <Setter Property="Template" Value="{StaticResource YFDangerButtonTemplate}" />
            </Style>

            <Style x:Key="YFIconButtonStyle" TargetType="Button" BasedOn="{StaticResource YFButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="YFTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="CornerRadius" Value="{StaticResource YFControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource YFOutlineButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
                <Setter Property="PlaceholderForeground" Value="{ThemeResource YFMutedBrush}" />
            </Style>

            <!--
                Passwortfelder sollen wie die übrigen Eingabefelder aussehen.
                PasswordBox kennt kein PlaceholderForeground, deshalb fehlt der Setter hier.
            -->
            <Style x:Key="YFPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="CornerRadius" Value="{StaticResource YFControlCornerRadius}" />
                <Setter Property="Background" Value="{ThemeResource YFOutlineButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YFStrokeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource YFTextBrush}" />
            </Style>

            <Style x:Key="YFListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
