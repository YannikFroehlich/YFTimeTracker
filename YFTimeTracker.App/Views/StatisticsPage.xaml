<Page
    x:Class="YFTimeTracker.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YFTimeTracker.App.Converters"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <converters:PointsCollectionConverter x:Key="PointsCollectionConverter" />
        <converters:ArcGeometryConverter x:Key="ArcGeometryConverter" />
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="StatisticsRoot"
            Padding="24,4,24,28"
            SizeChanged="StatisticsRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Statistiken" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Deine Spielmuster, Rekorde und Langzeittrends" />
                </StackPanel>
                <StackPanel
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="9">
                    <ComboBox
                        Width="150"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Periods}"
                        SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}" />
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource YFOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock Text="Aktualisieren" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="SummaryGrid" Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TotalCard" MinHeight="132" Padding="18" Background="{StaticResource YFBlueCardGradientBrush}" BorderBrush="#214A91" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SPIELZEIT" />
                            <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="#72A8FF" Glyph="&#xE823;" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="{Binding TotalDurationText}" />
                        <TextBlock Grid.Row="2" FontSize="12" Foreground="{Binding ComparisonColor, Converter={StaticResource HexColorBrushConverter}}" Text="{Binding ComparisonText}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border x:Name="SessionCard" Grid.Column="1" MinHeight="132" Padding="18" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SESSIONS" />
                            <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFPurpleBrush}" Glyph="&#xE787;" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" Text="{Binding SessionCountText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource YFMutedTextStyle}" Text="Im ausgewählten Zeitraum" />
                    </Grid>
                </Border>

                <Border x:Name="AverageCard" Grid.Column="2" MinHeight="132" Padding="18" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="Ø PRO SESSION" />
                            <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE9D2;" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="{Binding AverageDurationText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource YFMutedTextStyle}" Text="Durchschnittliche Dauer" />
                    </Grid>
                </Border>

                <Border x:Name="GamesCard" Grid.Column="3" MinHeight="132" Padding="18" Background="{StaticResource YFCyanCardGradientBrush}" BorderBrush="#176179" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="AKTIVE SPIELE" />
                            <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE7FC;" />
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" Text="{Binding GamesPlayedText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource YFMutedTextStyle}" Text="Mit erfasster Spielzeit" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="MainContentGrid" Grid.Row="2" ColumnSpacing="14" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.65*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TrendCard" MinHeight="410" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="SPIELZEIT-TREND" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="{Binding PeriodDescription}" />
                            </StackPanel>
                            <Border Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10233E" BorderBrush="#244D7E" BorderThickness="1" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource YFCyanBrush}" />
                                    <TextBlock FontSize="10" Foreground="#A8DFFF" Text="AKTUELLER ZEITRAUM" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding DataVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="202">
                                <TextBlock VerticalAlignment="Top" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ChartMaximumText}" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ChartMiddleText}" />
                                <TextBlock VerticalAlignment="Bottom" Style="{StaticResource YFMutedTextStyle}" Text="0 h" />
                            </Grid>
                            <Grid Grid.Column="1">
                                <Border Height="1" Margin="0,10,0,0" VerticalAlignment="Top" Background="#1A2B43" />
                                <Border Height="1" VerticalAlignment="Center" Background="#1A2B43" />
                                <Border Height="1" Margin="0,0,0,24" VerticalAlignment="Bottom" Background="#1A2B43" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                    <Grid MinWidth="{Binding ChartMinimumWidth}" VerticalAlignment="Top">
                                        <ItemsControl VerticalAlignment="Top" VerticalContentAlignment="Top" ItemsSource="{Binding Timeline}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="{Binding ItemWidth}" Height="226" ToolTipService.ToolTip="{Binding TooltipText}">
                                                        <TextBlock Height="24" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding DurationText}" TextTrimming="CharacterEllipsis" />
                                                        <Grid Height="160">
                                                            <Border Width="{Binding BarWidth}" Height="{Binding BarHeight}" VerticalAlignment="Bottom" Background="{Binding BarColor, Converter={StaticResource HexColorBrushConverter}}" CornerRadius="6,6,2,2" />
                                                        </Grid>
                                                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource YFMutedBrush}" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Canvas Height="160" Margin="0,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <Polygon Points="{Binding TrendAreaPoints, Converter={StaticResource PointsCollectionConverter}}" Fill="#292CE5F3" />
                                            <Polyline Points="{Binding TrendLinePoints, Converter={StaticResource PointsCollectionConverter}}" Stroke="{StaticResource YFCyanBrush}" StrokeLineJoin="Round" StrokeThickness="2" />
                                        </Canvas>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,28,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{Binding EmptyVisibility}">
                            <Border Width="70" Height="70" Background="#101E35" BorderBrush="#24446D" BorderThickness="1" CornerRadius="35">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="27" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE9D2;" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Noch keine Statistikdaten" />
                            <TextBlock MaxWidth="390" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Sobald eine Session erfasst wurde, erscheint hier dein echter Spielzeitverlauf." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="TopGamesCard" Grid.Column="1" MinHeight="410" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="TOP-SPIELE" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource YFCaptionStyle}" Text="NACH SPIELZEIT" />
                        </Grid>

                        <Grid Grid.Row="1" Height="140" Margin="0,10,0,0" Visibility="{Binding DataVisibility}">
                            <ItemsControl ItemsSource="{Binding GameShares}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid Width="140" Height="140" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Data="{Binding Converter={StaticResource ArcGeometryConverter}}" Stroke="{Binding StrokeColor, Converter={StaticResource HexColorBrushConverter}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="20" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" Text="{Binding TopGameShareText}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource YFCaptionStyle}" Text="TOP-SPIEL" />
                            </StackPanel>
                        </Grid>

                        <ListView
                            Grid.Row="2"
                            Margin="0,14,0,0"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource YFListViewItemStyle}"
                            ItemsSource="{Binding TopGames}"
                            SelectionMode="None"
                            Visibility="{Binding DataVisibility}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource YFMutedBrush}" Text="{Binding Rank}" />
                                        <Border Grid.Column="1" Width="40" Height="40" Background="#142845" BorderBrush="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" BorderThickness="1" CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="9" Foreground="{StaticResource YFMutedBrush}" Text="{Binding Source}" />
                                            </StackPanel>
                                            <ProgressBar Height="5" Maximum="100" Background="#132239" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Value="{Binding Progress}" />
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding SessionText}" />
                                                <TextBlock FontSize="10" Foreground="#52627A" Text="·" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding LastPlayedText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Text="{Binding DurationText}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding ShareText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{Binding EmptyVisibility}">
                            <FontIcon FontSize="28" Foreground="{StaticResource YFMutedBrush}" Glyph="&#xE7FC;" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Noch keine Spiele im Zeitraum" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="LowerContentGrid" Grid.Row="3" Margin="0,14,0,0" ColumnSpacing="14" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="WeekdayCard" MinHeight="300" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="WOCHENTAGE" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Verteilung deiner Spielzeit von Montag bis Sonntag" />
                        </StackPanel>
                        <ItemsControl Grid.Row="1" Margin="0,18,0,0" ItemsSource="{Binding Weekdays}" Visibility="{Binding DataVisibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding DayName}" />
                                        <ProgressBar Grid.Column="1" Height="7" Maximum="100" Background="#132239" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Value="{Binding Progress}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Text="{Binding DurationText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Noch keine Wochentagsdaten" Visibility="{Binding EmptyVisibility}" />
                    </Grid>
                </Border>

                <Border x:Name="InsightsCard" Grid.Column="1" MinHeight="300" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DEINE BESTWERTE" />
                        <Grid x:Name="InsightsGrid" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TopGameInsight" MinHeight="190" Padding="14" Background="#0A1A30" BorderBrush="#244D7E" BorderThickness="1" CornerRadius="11">
                                <StackPanel Spacing="9">
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#152E55" CornerRadius="19">
                                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE7FC;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="TOP-SPIEL" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding TopGameText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding TopGameDetailText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="WeekdayInsight" Grid.Column="1" MinHeight="190" Padding="14" Background="#15122E" BorderBrush="#4D357C" BorderThickness="1" CornerRadius="11">
                                <StackPanel Spacing="9">
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#2C2054" CornerRadius="19">
                                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource YFPurpleBrush}" Glyph="&#xE787;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="AKTIVSTER TAG" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding FavoriteWeekdayText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding FavoriteWeekdayDetailText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="LongestInsight" Grid.Column="2" MinHeight="190" Padding="14" Background="#09232D" BorderBrush="#176179" BorderThickness="1" CornerRadius="11">
                                <StackPanel Spacing="9">
                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="#0C3946" CornerRadius="19">
                                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE823;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="LÄNGSTE SESSION" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding LongestSessionText}" />
                                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding LongestSessionDetailText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="HeatmapCard" Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource YFCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="AKTIVITÄT" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Tägliche Spielzeit der letzten 26 Wochen" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{Binding HeatmapWeeks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Days}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" Spacing="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="14"
                                                    Height="14"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexColorBrushConverter}}"
                                                    CornerRadius="3"
                                                    ToolTipService.ToolTip="{Binding TooltipText}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Weniger" />
                        <Border Width="12" Height="12" Background="#10233E" CornerRadius="3" />
                        <Border Width="12" Height="12" Background="#33387BFF" CornerRadius="3" />
                        <Border Width="12" Height="12" Background="#66387BFF" CornerRadius="3" />
                        <Border Width="12" Height="12" Background="#99387BFF" CornerRadius="3" />
                        <Border Width="12" Height="12" Background="#387BFF" CornerRadius="3" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Mehr" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Margin="0,14,0,0" Padding="12,9" Background="#0A1728" BorderBrush="{StaticResource YFStrokeBrush}" BorderThickness="1" CornerRadius="9">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="13" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE946;" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
