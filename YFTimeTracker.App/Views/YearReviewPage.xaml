<Page
    x:Class="YFTimeTracker.App.Views.YearReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YFTimeTracker.App.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="ReviewRoot"
            Padding="24,4,24,28"
            SizeChanged="ReviewRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Jahresrückblick" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Deine persönlichen Spielzeit-Highlights eines ganzen Jahres" />
                </StackPanel>
                <StackPanel
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="9">
                    <ComboBox
                        Width="120"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding Years}"
                        SelectedItem="{Binding SelectedYear, Mode=TwoWay}" />
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource YFOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            <TextBlock Text="Aktualisieren" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ShareButton"
                        Click="ShareButton_Click"
                        IsEnabled="{Binding IsShareEnabled}"
                        Style="{StaticResource YFOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE72D;" />
                            <TextBlock Text="Als Bild teilen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="ShareContent" Grid.Row="1" Grid.RowSpan="4">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        MinHeight="190"
                        Margin="0,0,0,14"
                        Padding="24"
                        Background="{StaticResource YFBlueCardGradientBrush}"
                        BorderBrush="#285CA7"
                        BorderThickness="1"
                        CornerRadius="16">
                        <Grid>
                            <Ellipse Width="260" Height="260" Margin="0,-150,-80,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#172C67" Opacity="0.55" />
                            <Ellipse Width="180" Height="180" Margin="0,0,70,-125" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="#5C8BDB" StrokeThickness="1" Opacity="0.3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="5">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource YFCyanBrush}" Text="{Binding YearTitle}" />
                                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="46" FontWeight="SemiBold" Text="{Binding TotalPlaytimeText}" />
                                    <TextBlock FontSize="13" Foreground="{Binding ComparisonColor}" Text="{Binding ComparisonText}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="{Binding YearSubtitle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="86" Height="86" VerticalAlignment="Center" Background="#122D58" BorderBrush="#417AC2" BorderThickness="1" CornerRadius="43">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" Foreground="#8BC8FF" Glyph="&#xE787;" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="SummaryGrid" Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ActiveDaysCard" MinHeight="118" Padding="18" Style="{StaticResource YFCardStyle}">
                            <StackPanel Spacing="7">
                                <Grid>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SPIELTAGE" />
                                    <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE8F1;" />
                                </Grid>
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" Text="{Binding ActiveDaysText}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Tage mit erfasster Spielzeit" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="GamesCard" Grid.Column="1" MinHeight="118" Padding="18" Style="{StaticResource YFCardStyle}">
                            <StackPanel Spacing="7">
                                <Grid>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="GESPIELT" />
                                    <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFPurpleBrush}" Glyph="&#xE7FC;" />
                                </Grid>
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" Text="{Binding GamesPlayedText}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Unterschiedliche Spiele" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SessionsCard" Grid.Column="2" MinHeight="118" Padding="18" Style="{StaticResource YFCardStyle}">
                            <StackPanel Spacing="7">
                                <Grid>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SESSIONS" />
                                    <FontIcon HorizontalAlignment="Right" FontSize="18" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE916;" />
                                </Grid>
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" Text="{Binding SessionCountText}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Erfasste Spielstarts" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="ReviewContentGrid"
                        Grid.Row="2"
                        Margin="0,0,0,14"
                        ColumnSpacing="14"
                        RowSpacing="14"
                        Visibility="{Binding DataVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="0.65*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="MonthCard" MinHeight="330" Style="{StaticResource YFCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DEIN JAHR IN MONATEN" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Spielzeit von Januar bis Dezember" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ChartMaximumText}" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Months}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="66" Height="218">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="30" />
                                                        <RowDefinition Height="160" />
                                                        <RowDefinition Height="28" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding DurationText}" />
                                                    <Border
                                                        Grid.Row="1"
                                                        Width="34"
                                                        Height="{Binding BarHeight}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Bottom"
                                                        Background="{Binding BarColor}"
                                                        CornerRadius="6,6,2,2" />
                                                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="11" FontWeight="SemiBold" Text="{Binding Month}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="HighlightsCard" Grid.Column="1" MinHeight="330" Style="{StaticResource YFCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="HIGHLIGHTS" />
                                <Border Padding="16" Background="#0E1D33" BorderBrush="#1D3C61" BorderThickness="1" CornerRadius="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#12394A" CornerRadius="11">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE823;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="AKTIVSTER MONAT" />
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding MostActiveMonthText}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding MostActiveMonthDetailText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Padding="16" Background="#121A31" BorderBrush="#34305B" BorderThickness="1" CornerRadius="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" Background="#251B43" CornerRadius="11">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource YFPurpleBrush}" Glyph="&#xE787;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="LÄNGSTE SESSION" />
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding LongestSessionText}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding LongestSessionDetailText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,0,0,14" Style="{StaticResource YFCardStyle}" Visibility="{Binding DataVisibility}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="MEISTGESPIELTE SPIELE" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Deine Top 8 nach erfasster Spielzeit" />
                            </StackPanel>
                            <ListView Grid.Row="1" Margin="0,14,0,0" IsItemClickEnabled="True" ItemClick="TopGames_ItemClick" ItemContainerStyle="{StaticResource YFListViewItemStyle}" ItemsSource="{Binding TopGames}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="68" Padding="8,9" BorderBrush="#142239" BorderThickness="0,1,0,0">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource YFMutedBrush}" Text="{Binding Rank}" />
                                                <controls:GameIcon
                                                    Grid.Column="1"
                                                    Width="42"
                                                    Height="42"
                                                    Background="{StaticResource YFLogoGradientBrush}"
                                                    FontSize="11"
                                                    IconCornerRadius="9"
                                                    IconPath="{Binding IconPath}"
                                                    Initials="{Binding Initials}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="9" Foreground="{StaticResource YFCyanBrush}" Text="{Binding Source}" />
                                                    </StackPanel>
                                                    <ProgressBar Height="5" Maximum="100" Background="#132239" Foreground="{StaticResource YFBlueBrush}" Value="{Binding Progress}" />
                                                    <TextBlock FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding SessionText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="#8BB7FF" Text="{Binding DurationText}" />
                                                    <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding ShareText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.RowSpan="2" MinHeight="260" Background="#07101E" BorderBrush="{StaticResource YFStrokeBrush}" BorderThickness="1" CornerRadius="14" Visibility="{Binding EmptyVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <Border Width="72" Height="72" Background="#101E35" BorderBrush="#24446D" BorderThickness="1" CornerRadius="36">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE787;" />
                            </Border>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Noch keine Spielzeit in diesem Jahr" />
                            <TextBlock MaxWidth="480" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Sobald Sessions erfasst wurden, erscheinen hier Monatsverlauf, Rekorde und deine meistgespielten Spiele." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,2,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8" Visibility="{Binding DataVisibility}">
                        <Image Width="18" Height="18" Source="/Assets/YFTimeTrackerLogo.png" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource YFMutedBrush}" Text="{Binding ShareFooterText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Padding="12,9" Background="#081321" BorderBrush="{StaticResource YFStrokeBrush}" BorderThickness="1" CornerRadius="9">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource YFMutedBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        Padding="10,6"
                        Command="{Binding OpenExportFolderCommand}"
                        IsEnabled="{Binding IsExportFolderAvailable}"
                        Style="{StaticResource YFOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontSize="12" Glyph="&#xED25;" />
                            <TextBlock FontSize="12" Text="Ordner öffnen" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
