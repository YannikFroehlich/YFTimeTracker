<ContentDialog
    x:Class="YFTimeTracker.App.Views.FirstRunSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource YFSurfaceRaisedBrush}"
    BorderBrush="{StaticResource YFStrokeBrightBrush}"
    BorderThickness="1"
    CornerRadius="18"
    RequestedTheme="Dark">
    <Grid Width="500" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,4,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="38" Height="38" Source="/Assets/YFTimeTrackerLogo.png" Stretch="Uniform" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" Text="YFTimeTracker einrichten" />
                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="In wenigen Schritten startklar" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                <Border x:Name="StepIndicator0" Width="28" Height="4" Background="{StaticResource YFBlueBrush}" CornerRadius="2" />
                <Border x:Name="StepIndicator1" Width="18" Height="4" Background="{StaticResource YFStrokeBrush}" CornerRadius="2" />
                <Border x:Name="StepIndicator2" Width="18" Height="4" Background="{StaticResource YFStrokeBrush}" CornerRadius="2" />
                <Border x:Name="StepIndicator3" Width="18" Height="4" Background="{StaticResource YFStrokeBrush}" CornerRadius="2" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="WelcomeStep" Spacing="18">
                <Border Padding="24" BorderBrush="{StaticResource YFStrokeBrightBrush}" BorderThickness="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#123C78" Offset="0" />
                            <GradientStop Color="#241858" Offset="0.62" />
                            <GradientStop Color="#091323" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="104" Height="104" Background="#080E19" CornerRadius="28">
                            <Image Margin="8" Source="/Assets/YFTimeTrackerLogo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" Text="Willkommen bei YFTimeTracker" TextWrapping="Wrap" />
                            <TextBlock Foreground="{StaticResource YFMutedBrush}" Text="Deine Spielzeit wird automatisch erfasst und übersichtlich ausgewertet – ohne Konto und ohne Cloud-Zwang." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Background="#0B3039" CornerRadius="11">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE72E;" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Deine Daten bleiben auf diesem Computer" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Spiele, Sessions, Einstellungen, Backups und Logs werden ausschließlich unter %LocalAppData%\YFTimeTracker gespeichert." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Du kannst alle Optionen später in den Einstellungen ändern und diesen Assistenten erneut öffnen." TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="TrackingStep" Visibility="Collapsed" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="AUTOMATISCHES TRACKING" />
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" Text="Spiele erkennen, während du spielst" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="YFTimeTracker prüft nur lokale Prozesse und Launcher-Dateien. Unbekannte Programme außerhalb erkannter Spieleordner werden nicht importiert." TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="#102B50" CornerRadius="12">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE823;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Spielzeit automatisch erfassen" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Startet und beendet Sessions anhand laufender Spiele." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrackingToggle" Grid.Column="2" VerticalAlignment="Center" OffContent="Pausiert" OnContent="Aktiv" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="#291B52" CornerRadius="12">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#B18CFF" Glyph="&#xE7FC;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Steam, Epic, GOG und Xbox erkennen" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Liest lokale Installationen und übernimmt ein Spiel erst beim tatsächlichen Start." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LauncherToggle" Grid.Column="2" VerticalAlignment="Center" OffContent="Aus" OnContent="Aktiv" />
                    </Grid>
                </Border>

                <Border Padding="14,12" Background="#08182B" CornerRadius="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="15" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE946;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource YFMutedTextStyle}" Text="Launcher-Anmeldedaten werden weder gelesen noch benötigt. Es werden keine Web-APIs kontaktiert." TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="WindowsStep" Visibility="Collapsed" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="WINDOWS &amp; TRAY" />
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" Text="Auch im Hintergrund zuverlässig" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Tracking läuft weiter, solange YFTimeTracker im Infobereich aktiv ist. Vollständig beendet wird die App über das Tray-Menü." TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="#0B3039" CornerRadius="12">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE7E8;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Beim Schließen im Tray behalten" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Das Fenster verschwindet, die Zeiterfassung läuft weiter." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" VerticalAlignment="Center" OffContent="App beenden" OnContent="Im Tray" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="#291B52" CornerRadius="12">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#B18CFF" Glyph="&#xE7F4;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="Mit Windows starten" />
                            <TextBlock x:Name="StartupHelpText" Style="{StaticResource YFMutedTextStyle}" Text="Startet minimiert und beginnt automatisch mit der Erfassung." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" VerticalAlignment="Center" OffContent="Aus" OnContent="Aktiv" />
                    </Grid>
                </Border>

                <Border Padding="14,12" Background="#11152B" CornerRadius="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource YFGreenBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource YFMutedTextStyle}" Text="Doppelklick auf das Tray-Symbol öffnet jederzeit das Dashboard." TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ReadyStep" Visibility="Collapsed" Spacing="18">
                <Border Padding="24" BorderBrush="{StaticResource YFStrokeBrightBrush}" BorderThickness="1" CornerRadius="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0B3342" Offset="0" />
                            <GradientStop Color="#162B59" Offset="0.55" />
                            <GradientStop Color="#17113A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Border Width="76" Height="76" Background="#102A42" CornerRadius="38">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" Foreground="{StaticResource YFGreenBrush}" Glyph="&#xE73E;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold" Text="Bereit für deine erste Session" />
                        <TextBlock MaxWidth="500" HorizontalTextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Prüfe deine Auswahl. Mit „Einrichtung abschließen“ werden die Einstellungen gespeichert und das Dashboard geöffnet." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource YFSubtleCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DEINE AUSWAHL" />
                        <TextBlock x:Name="TrackingSummaryText" Text="Automatisches Tracking" />
                        <TextBlock x:Name="LauncherSummaryText" Text="Launcher-Erkennung" />
                        <TextBlock x:Name="TraySummaryText" Text="Tray-Verhalten" />
                        <TextBlock x:Name="StartupSummaryText" Text="Windows-Autostart" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="ErrorText"
                Margin="0,0,0,12"
                Foreground="{StaticResource YFRedBrush}"
                Text="Die Einstellungen konnten nicht gespeichert werden. Bitte erneut versuchen."
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <Grid Grid.Row="1">
                <TextBlock x:Name="StepText" VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Schritt 1 von 4" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SkipButton" Click="SkipButton_Click" Content="Später" Style="{StaticResource YFOutlineButtonStyle}" />
                    <Button x:Name="BackButton" Click="BackButton_Click" Content="Zurück" Style="{StaticResource YFOutlineButtonStyle}" Visibility="Collapsed" />
                    <Button x:Name="NextButton" Click="NextButton_Click" Content="Weiter" Style="{StaticResource YFAccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
