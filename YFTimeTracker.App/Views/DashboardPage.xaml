<Page
    x:Class="YFTimeTracker.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YFTimeTracker.App.Controls"
    xmlns:converters="using:YFTimeTracker.App.Converters"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="DashboardRoot"
            Padding="24,4,24,28"
            SizeChanged="DashboardRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Dashboard" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Deine Spielzeit auf einen Blick" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource YFOutlineButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                        <TextBlock Text="Aktualisieren" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="StatsGrid" Grid.Row="1" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="TodayCard"
                    MinHeight="142"
                    Padding="20"
                    Background="{ThemeResource YFSurfaceBrush}"
                    BorderBrush="{ThemeResource YFStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource YFCardCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource YFMetricIconStyle}" Background="{ThemeResource YFTintBrush}" BorderBrush="{ThemeResource YFStrokeBrush}">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="{ThemeResource YFAccentTextBrush}" Glyph="&#xE823;" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="HEUTE" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontFamily="{StaticResource YFDisplayFontFamily}" FontSize="32" FontWeight="SemiBold" Text="{Binding TodayText}" />
                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding TodaySessionText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" controls:ThemeInk.Foreground="{Binding TodayComparisonBrush}" Text="{Binding TodayComparisonText}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="WeekCard"
                    Grid.Column="1"
                    MinHeight="142"
                    Margin="12,0"
                    Padding="20"
                    Background="{ThemeResource YFSurfaceBrush}"
                    BorderBrush="{ThemeResource YFStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource YFCardCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource YFMetricIconStyle}" Background="{ThemeResource YFTintBrush}" BorderBrush="{ThemeResource YFStrokeBrush}">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{ThemeResource YFSecondaryTextBrush}" Glyph="&#xE787;" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="DIESE WOCHE" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontFamily="{StaticResource YFDisplayFontFamily}" FontSize="32" FontWeight="SemiBold" Text="{Binding WeekText}" />
                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding WeekSessionText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" controls:ThemeInk.Foreground="{Binding WeekComparisonBrush}" Text="{Binding WeekComparisonText}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="TotalCard"
                    Grid.Column="2"
                    MinHeight="142"
                    Padding="20"
                    Background="{ThemeResource YFSurfaceBrush}"
                    BorderBrush="{ThemeResource YFStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource YFCardCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource YFMetricIconStyle}" Background="{ThemeResource YFTintBrush}" BorderBrush="{ThemeResource YFStrokeBrush}">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Foreground="{ThemeResource YFSecondaryTextBrush}" Glyph="&#xE7AC;" />
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource YFCaptionStyle}" Text="GESAMTSPIELZEIT" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontFamily="{StaticResource YFDisplayFontFamily}" FontSize="32" FontWeight="SemiBold" Text="{Binding TotalText}" />
                            <TextBlock Grid.Row="2" Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="{Binding GamesPlayedText}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="DetailsGrid" Grid.Row="2" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TrackingCard" MinHeight="330" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="AKTUELLES TRACKING" />
                            <Border
                                Padding="9,4"
                                HorizontalAlignment="Right"
                                Visibility="{Binding ActiveGameVisibility}"
                                Background="{ThemeResource YFStatusChipSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource YFStatusChipSuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource YFGreenBrush}" />
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource YFStatusChipSuccessForegroundBrush}" Text="LIVE" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid
                            x:Name="ActiveGameContent"
                            Grid.Row="1"
                            Margin="0,18,0,0"
                            Visibility="{Binding ActiveGameVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,18,0" Background="{StaticResource YFAccentBrush}" CornerRadius="4">
                                <Grid>
                                    <controls:GameIcon
                                        Background="Transparent"
                                        FontFamily="{StaticResource YFDisplayFontFamily}"
                                        FontSize="38"
                                        Foreground="White"
                                        IconCornerRadius="4"
                                        IconPadding="22"
                                        IconPath="{Binding ActiveGameIconPath}"
                                        Initials="{Binding ActiveGameInitials}" />
                                    <Border Margin="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#B2050B16" CornerRadius="4">
                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White" Text="AUTOMATISCH" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <TextBlock FontFamily="{StaticResource YFDisplayFontFamily}" FontSize="28" FontWeight="SemiBold" Text="{Binding ActiveGameName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding ActiveGameHint}" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource YFAccentTextBrush}" Text="{Binding AdditionalRunningGamesText}" />
                                <TextBlock Margin="0,7,0,0" Style="{StaticResource YFCaptionStyle}" Text="SESSION-LAUFZEIT" />
                                <TextBlock
                                    FontFamily="{StaticResource YFMonoFontFamily}"
                                    FontSize="31"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource YFAccentTextBrush}"
                                    Text="{Binding ActiveElapsedText}" />
                                <StackPanel Spacing="5" Visibility="{Binding ActiveDailyProgressVisibility}">
                                    <ProgressBar
                                        Width="220"
                                        Height="5"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource YFButtonBackgroundBrush}"
                                        Foreground="{Binding ActiveDailyProgressColor, Converter={StaticResource HexColorBrushConverter}}"
                                        Maximum="100"
                                        Value="{Binding ActiveDailyProgressPercent}" />
                                    <TextBlock FontSize="10" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding ActiveDailyProgressText}" />
                                </StackPanel>
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenLibrary_Click" Style="{StaticResource YFOutlineButtonStyle}" Content="Bibliothek" />
                                    <Button Command="{Binding ToggleTrackingCommand}" Style="{StaticResource YFDangerButtonStyle}" Content="{Binding PauseButtonText}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,18,0,0" Visibility="{Binding ActiveEmptyVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="74" Height="74" Background="{ThemeResource YFEmptyStateIconBrush}" BorderBrush="{ThemeResource YFEmptyStateIconBorderBrush}" BorderThickness="1" CornerRadius="37">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Foreground="{ThemeResource YFAccentTextBrush}" Glyph="&#xE7FC;" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding ActiveGameName}" />
                                <TextBlock MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ActiveGameHint}" TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenLibrary_Click" Style="{StaticResource YFAccentButtonStyle}" Content="Spiel registrieren" />
                                    <Button Command="{Binding ToggleTrackingCommand}" Style="{StaticResource YFOutlineButtonStyle}" Content="{Binding PauseButtonText}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ChartCard" Grid.Column="1" Margin="14,0,0,0" MinHeight="330" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="WÖCHENTLICHE SPIELZEIT" />
                            <Border Padding="9,4" HorizontalAlignment="Right" Background="{ThemeResource YFListRowBackgroundHoverBrush}" CornerRadius="{StaticResource YFChipCornerRadius}">
                                <TextBlock FontSize="10" Foreground="{ThemeResource YFMutedBrush}" Text="DIESE WOCHE" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Height="196" Margin="0,18,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Beschriftung mittig auf den Hilfslinien (Textzeile etwa 18 px hoch). -->
                            <Grid Margin="0,27,0,19">
                                <TextBlock VerticalAlignment="Top" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ChartMaximumText}" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="{Binding ChartMiddleText}" />
                                <TextBlock VerticalAlignment="Bottom" Style="{StaticResource YFMutedTextStyle}" Text="0 h" />
                            </Grid>
                            <!--
                                Hilfslinien oben, Mitte, unten. Keine 1-px-Zeilen: die Balken spannen sonst über alle
                                Zeilen, das Grid verteilt ihre Höhe auch auf diese Zeilen, und die Linien werden zu Flächen.
                            -->
                            <Grid Grid.Column="1">
                                <!-- Balkenfläche: höchster Balken (132 px) endet 36 px unter der Oberkante, null liegt über den Tagesnamen (28 px). -->
                                <Grid Margin="0,36,0,28">
                                    <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource YFStrokeBrush}" />
                                    <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource YFStrokeBrush}" />
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource YFStrokeBrush}" />
                                </Grid>
                                <ItemsRepeater ItemsSource="{Binding WeekDays}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="7"
                                            MinItemHeight="196"
                                            MinItemWidth="36" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="196">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="140" />
                                                    <RowDefinition Height="28" />
                                                </Grid.RowDefinitions>
                                                <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="{Binding DurationText}" />
                                                <Border
                                                    Grid.Row="1"
                                                    Width="34"
                                                    Height="{Binding BarHeight}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Background="{Binding BarBrush}"
                                                    CornerRadius="2,2,0,0" />
                                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource YFMutedTextStyle}" Text="{Binding DayLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Foreground="{ThemeResource YFAccentTextBrush}" Glyph="&#xE823;" />
                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource YFAccentTextBrush}" Text="{Binding WeekText}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="insgesamt" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" controls:ThemeInk.Foreground="{Binding WeekComparisonBrush}" Text="{Binding WeekComparisonText}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource YFCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="ZULETZT GESPIELT" />
                        <Button HorizontalAlignment="Right" Click="OpenLibrary_Click" Style="{StaticResource YFOutlineButtonStyle}" Content="Alle Spiele" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,8" Visibility="{Binding RecentGamesVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SPIEL" />
                        <TextBlock Grid.Column="1" Style="{StaticResource YFCaptionStyle}" Text="GESAMTSPIELZEIT" />
                        <TextBlock Grid.Column="2" Style="{StaticResource YFCaptionStyle}" Text="LETZTE SESSION" />
                    </Grid>
                    <ListView
                        Grid.Row="2"
                        IsItemClickEnabled="True"
                        ItemContainerStyle="{StaticResource YFListViewItemStyle}"
                        ItemClick="RecentGames_ItemClick"
                        ItemsSource="{Binding RecentGames}"
                        SelectionMode="None"
                        Visibility="{Binding RecentGamesVisibility}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="58" BorderBrush="{ThemeResource YFStrokeBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:GameIcon
                                                Width="48"
                                                Height="36"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource YFAccentBrush}"
                                                FontSize="11"
                                                IconCornerRadius="4"
                                                IconPath="{Binding IconPath}"
                                                Initials="{Binding Initials}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource YFTextBrush}" Text="{Binding TotalPlaytime}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" controls:ThemeInk.Foreground="{Binding LastSessionBrush}" Text="{Binding LastSession}" />
                                        <FontIcon Grid.Column="3" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource YFMutedBrush}" Glyph="&#xE76C;" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Row="2" MinHeight="150" Background="{ThemeResource YFEmptyStatePanelBrush}" CornerRadius="4" Visibility="{Binding RecentEmptyVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon FontSize="26" Foreground="{ThemeResource YFAccentTextBrush}" Glyph="&#xE8D4;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Noch keine Spielhistorie" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Abgeschlossene Sessions erscheinen automatisch hier." TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
