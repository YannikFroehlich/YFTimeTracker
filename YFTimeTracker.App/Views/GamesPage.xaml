<Page
    x:Class="YFTimeTracker.App.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YFTimeTracker.App.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LibraryRoot" Padding="24,4,24,28" SizeChanged="LibraryRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Bibliothek" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Verwalte Spiele und korrigiere aufgezeichnete Sessions" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding NewGameCommand}"
                    Style="{StaticResource YFAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                        <TextBlock Text="Neues Spiel" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="0,0,0,14" Padding="14" Style="{StaticResource YFCardStyle}">
                <Grid x:Name="LibraryFilterGrid" ColumnSpacing="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="LibrarySearchBox"
                        PlaceholderText="Spielname, EXE oder Installationsordner suchen …"
                        Style="{StaticResource YFTextBoxStyle}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        x:Name="SourceFilterBox"
                        Grid.Column="1"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding SourceFilters}"
                        SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}" />
                    <ComboBox
                        x:Name="StatusFilterBox"
                        Grid.Column="2"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding StatusFilters}"
                        SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                    <ComboBox
                        x:Name="SortBox"
                        Grid.Column="3"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
                    <Button
                        x:Name="ClearFiltersButton"
                        Grid.Column="4"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource YFOutlineButtonStyle}"
                        Content="Zurücksetzen" />
                </Grid>
            </Border>

            <Grid x:Name="LibraryContent" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="GamesListCard" Style="{StaticResource YFCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DEINE SPIELE" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7">
                                <Border Padding="8,4" VerticalAlignment="Center" Background="#10243F" CornerRadius="7">
                                    <TextBlock FontSize="9" Foreground="{StaticResource YFBlueBrush}" Text="{Binding ResultSummary}" />
                                </Border>
                                <Button
                                    Width="34"
                                    Height="34"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource YFIconButtonStyle}"
                                    ToolTipService.ToolTip="Bibliothek aktualisieren">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,8,0,12" Style="{StaticResource YFMutedTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <ListView
                            Grid.Row="2"
                            MinHeight="480"
                            ItemsSource="{Binding Games}"
                            SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                            Visibility="{Binding GamesVisibility}">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#10243F" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#17345A" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#132D64" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#173875" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#1B4388" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource YFListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="66" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="10" />
                                    <Setter Property="Background" Value="#091628" />
                                    <Setter Property="BorderBrush" Value="#172B46" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <controls:GameIcon
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource YFLogoGradientBrush}"
                                            FontSize="12"
                                            IconCornerRadius="9"
                                            IconPath="{Binding IconPath}"
                                            Initials="{Binding Initials}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="{Binding ExecutableColor}" Text="{Binding ExecutableDisplay}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock FontSize="9" Foreground="{StaticResource YFCyanBrush}" Text="{Binding SourceLabel}" />
                                                <TextBlock FontSize="10" Foreground="{Binding ActivityColor}" Text="{Binding ActivityText}" />
                                                <TextBlock FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="{Binding LastPlayedText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Width="34"
                                            Height="34"
                                            VerticalAlignment="Center"
                                            Click="OpenGameDetails_Click"
                                            Style="{StaticResource YFIconButtonStyle}"
                                            Tag="{Binding Id}"
                                            ToolTipService.ToolTip="Spieldetails öffnen">
                                            <FontIcon FontSize="13" Glyph="&#xE76C;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{Binding EmptyVisibility}">
                            <Border Width="62" Height="62" Background="#101E35" BorderBrush="#24446D" BorderThickness="1" CornerRadius="31">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE7FC;" />
                            </Border>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Keine Spiele gefunden" />
                            <TextBlock MaxWidth="290" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="{Binding EmptyStateText}" TextWrapping="Wrap" />
                            <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource YFOutlineButtonStyle}" Content="Filter zurücksetzen" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="EditorCard" Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="SPIELINFORMATIONEN" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Ein Spiel wird anhand seines vollständigen EXE-Pfads erkannt." />
                            </StackPanel>
                            <Border Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10243F" CornerRadius="8">
                                <TextBlock FontSize="10" Foreground="{StaticResource YFBlueBrush}" Text="LOKALES TRACKING" />
                            </Border>
                        </Grid>

                        <TextBox
                            Header="Anzeigename"
                            PlaceholderText="Zum Beispiel: Minecraft"
                            Style="{StaticResource YFTextBoxStyle}"
                            Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="EXE-Pfad"
                                PlaceholderText="C:\Spiele\MeinSpiel\game.exe"
                                Style="{StaticResource YFTextBoxStyle}"
                                Text="{Binding ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{Binding BrowseExecutableCommand}"
                                Style="{StaticResource YFOutlineButtonStyle}"
                                Content="Durchsuchen" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Button Command="{Binding AddOrUpdateGameCommand}" Style="{StaticResource YFAccentButtonStyle}" Content="Spiel speichern" />
                            <Button Command="{Binding DeleteSelectedGameCommand}" Style="{StaticResource YFDangerButtonStyle}" Content="Spiel löschen" />
                            <Button Command="{Binding NewGameCommand}" Style="{StaticResource YFOutlineButtonStyle}" Content="Eingaben leeren" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource YFStrokeBrush}" />

                        <StackPanel Spacing="5">
                            <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="SESSIONS" />
                            <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Fehlende Spielzeit kann manuell ergänzt werden." />
                        </StackPanel>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Start (lokal)" Style="{StaticResource YFTextBoxStyle}" Text="{Binding ManualStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="Ende (lokal)" Style="{StaticResource YFTextBoxStyle}" Text="{Binding ManualEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{Binding AddManualSessionCommand}"
                                Style="{StaticResource YFOutlineButtonStyle}"
                                Content="Hinzufügen" />
                        </Grid>

                        <Border Background="#07111F" BorderBrush="{StaticResource YFStrokeBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="14,10" Background="#0A1728">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource YFCaptionStyle}" Text="START" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource YFCaptionStyle}" Text="ENDE" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource YFCaptionStyle}" Text="DAUER" />
                                </Grid>
                                <ListView
                                    Grid.Row="1"
                                    MinHeight="220"
                                    ItemContainerStyle="{StaticResource YFListViewItemStyle}"
                                    ItemsSource="{Binding Sessions}"
                                    SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border MinHeight="48" Padding="14,8" BorderBrush="#142239" BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding StartedAt}" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource YFMutedBrush}" Text="{Binding EndedAt}" />
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource YFBlueBrush}" Text="{Binding Duration}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding DeleteSelectedSessionCommand}"
                            Style="{StaticResource YFDangerButtonStyle}"
                            Content="Ausgewählte Session löschen" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,9" Background="#0A1728" BorderBrush="{StaticResource YFStrokeBrush}" BorderThickness="1" CornerRadius="9">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="13" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE946;" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
