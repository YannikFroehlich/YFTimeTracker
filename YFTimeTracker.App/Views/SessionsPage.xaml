<Page
    x:Class="YFTimeTracker.App.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,4,24,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Sessions" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Eine zentrale Zeitleiste für alle Spielsessions" />
                </StackPanel>
                <Border Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#281B52" BorderBrush="#6545A8" BorderThickness="1" CornerRadius="9">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="11" Foreground="#B18CFF" Glyph="&#xE7BA;" />
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#C8AEFF" Text="VORSCHAU" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource YFBlueCardGradientBrush}" BorderBrush="#214A91" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="7">
                        <TextBlock Style="{StaticResource YFCaptionStyle}" Text="SESSIONS HEUTE" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="—" />
                        <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Zentrale Auswertung folgt" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource YFPurpleCardGradientBrush}" BorderBrush="#38266D" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="7">
                        <TextBlock Style="{StaticResource YFCaptionStyle}" Text="LÄNGSTE SESSION" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="—" />
                        <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Vorschau ohne Beispielwerte" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource YFCyanCardGradientBrush}" BorderBrush="#18566D" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="7">
                        <TextBlock Style="{StaticResource YFCaptionStyle}" Text="Ø SESSION" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="—" />
                        <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Wird später berechnet" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,14,0,0" MinHeight="410" Style="{StaticResource YFCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="SESSION-ZEITLEISTE" />
                        <Border Padding="9,4" HorizontalAlignment="Right" Background="#182440" CornerRadius="7">
                            <TextBlock FontSize="10" Foreground="{StaticResource YFMutedBrush}" Text="DEMÄCHST" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Border Width="82" Height="82" Background="#101E35" BorderBrush="#24446D" BorderThickness="1" CornerRadius="41">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="31" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE787;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="Zentrale Session-Ansicht in Vorbereitung" />
                        <TextBlock MaxWidth="570" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Sessions lassen sich bereits pro Spiel in der Bibliothek ansehen, ergänzen und löschen. Diese Seite wird später alle Sessions zusammenführen und filtern." TextWrapping="Wrap" />
                        <Button Click="OpenLibrary_Click" Style="{StaticResource YFAccentButtonStyle}" Content="Sessions in der Bibliothek verwalten" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
