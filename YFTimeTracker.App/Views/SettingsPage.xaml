<Page
    x:Class="YFTimeTracker.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:YFTimeTracker.App.Converters"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <converters:HexColorBrushConverter x:Key="HexColorBrushConverter" />
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsRoot" Padding="24,4,24,28" SizeChanged="SettingsRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource YFPageTitleStyle}" Text="Einstellungen" />
                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Passe Tracking, Windows-Integration und lokale Datensicherung an" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Command="{Binding SaveCommand}" Style="{StaticResource YFAccentButtonStyle}" Content="Änderungen speichern" />
            </Grid>

            <Grid x:Name="SettingsGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="TrackingSettingsCard" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="TRACKING" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Automatische Erkennung und Aktualisierung" />
                            </StackPanel>
                            <Border Width="46" Height="46" HorizontalAlignment="Right" Background="#102B50" CornerRadius="12">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE823;" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <ToggleSwitch
                                Header="Tracking aktivieren"
                                OffContent="Pausiert"
                                OnContent="Aktiv"
                                IsOn="{Binding TrackingEnabled, Mode=TwoWay}" />
                        </Border>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <StackPanel Spacing="10">
                                <ToggleSwitch
                                    Header="Launcher automatisch erkennen"
                                    OffContent="Nur Bibliothek"
                                    OnContent="Steam, Epic, GOG, Xbox, Battle.net, Ubisoft, EA app"
                                    IsOn="{Binding LauncherDiscoveryEnabled, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Steam" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding SteamStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Epic" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding EpicStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="GOG" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding GogStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Xbox / Microsoft Store" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding XboxStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Battle.net" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding BattleNetStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Ubisoft Connect" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding UbisoftStatusText}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="EA app" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource YFMutedTextStyle}" Text="{Binding EaAppStatusText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding TrackingIntervalSeconds, Mode=TwoWay}">
                                <NumberBox.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Scan-Intervall (Sek.)" />
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{StaticResource YFCyanBrush}"
                                            Glyph="&#xE946;">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="280" Text="Wie oft YFTimeTracker die laufenden Prozesse pr&#252;ft, um Spielstarts und -enden zu erkennen. Kleinere Werte erkennen Starts schneller, verursachen aber mehr Systemlast." TextWrapping="Wrap" />
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </FontIcon>
                                    </StackPanel>
                                </NumberBox.Header>
                            </NumberBox>
                            <NumberBox
                                Grid.Column="1"
                                Minimum="5"
                                Maximum="300"
                                SpinButtonPlacementMode="Compact"
                                Value="{Binding HeartbeatIntervalSeconds, Mode=TwoWay}">
                                <NumberBox.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Heartbeat (Sek.)" />
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{StaticResource YFCyanBrush}"
                                            Glyph="&#xE946;">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="280" Text="Wie oft die Spielzeit einer laufenden Session gespeichert wird. Nach einem Absturz oder Stromausfall geht h&#246;chstens dieser Zeitraum verloren; kleinere Werte schreiben h&#228;ufiger in die Datenbank." TextWrapping="Wrap" />
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </FontIcon>
                                    </StackPanel>
                                </NumberBox.Header>
                            </NumberBox>
                        </Grid>

                        <Border Padding="12,10" Background="{ThemeResource YFStatusBarBrush}" CornerRadius="9">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE946;" />
                                <TextBlock MaxWidth="420" Style="{StaticResource YFMutedTextStyle}" Text="Kürzere Intervalle reagieren schneller, benötigen aber etwas mehr Systemleistung." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="WindowsSettingsCard" Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="WINDOWS &amp; TRAY" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Verhalten im Hintergrund und beim Systemstart" />
                            </StackPanel>
                            <Border Width="46" Height="46" HorizontalAlignment="Right" Background="#291B52" CornerRadius="12">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#B18CFF" Glyph="&#xE7F4;" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource YFCaptionStyle}" Text="DESIGN" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <ToggleSwitch
                                Header="Beim Schließen im Tray behalten"
                                OffContent="App beenden"
                                OnContent="Im Hintergrund"
                                IsOn="{Binding MinimizeOnClose, Mode=TwoWay}" />
                        </Border>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <ToggleSwitch
                                Header="Minimiert starten"
                                OffContent="Fenster anzeigen"
                                OnContent="Direkt im Tray"
                                IsOn="{Binding StartMinimized, Mode=TwoWay}" />
                        </Border>

                        <Border Style="{StaticResource YFSubtleCardStyle}">
                            <Grid>
                                <ToggleSwitch
                                    Header="Mit Windows starten"
                                    OffContent="Deaktiviert"
                                    OnContent="Aktiviert"
                                    IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                                <Border Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource YFStatusBarBrush}" CornerRadius="7">
                                    <TextBlock FontSize="10" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding StartupStateText}" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Padding="12,10" Background="{ThemeResource YFStatusBarBrush}" CornerRadius="9">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource YFGreenBrush}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Das Tray-Symbol zeigt den aktuellen Trackingstatus." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OpenSetupAssistant_Click"
                            Style="{StaticResource YFOutlineButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon FontSize="14" Glyph="&#xE897;" />
                                <TextBlock Text="Einrichtungs-Assistent erneut öffnen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="DataSettingsCard" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Margin="0,0,44,0">
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DATEN &amp; SICHERUNG" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Alle Daten bleiben lokal auf diesem Computer" />
                            </StackPanel>
                            <Border Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0B3039" CornerRadius="10">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource YFCyanBrush}" Glyph="&#xE8F1;" />
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="14">
                                <NumberBox
                                    Header="Backup-Aufbewahrung (Tage)"
                                    Maximum="365"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding BackupRetentionDays, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Speicherort: %LocalAppData%\YFTimeTracker" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <Button HorizontalAlignment="Stretch" Command="{Binding ExportCommand}" Style="{StaticResource YFAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                        <TextBlock Text="Daten exportieren" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Click="ImportBackup_Click" Style="{StaticResource YFOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                                        <TextBlock Text="Sicherung importieren" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Exporte enthalten Spiele, Sessions und Einstellungen in einem ZIP-Archiv. Ein Import ersetzt alle lokalen Daten." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource YFStrokeBrush}" />

                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="SICHERUNGSZIEL" />
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="{StaticResource YFCyanBrush}"
                                        Glyph="&#xE946;">
                                        <ToolTipService.ToolTip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="320" Spacing="6">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="Lokal:" />
                                                        <Run Text="Es wird keine zusätzliche Kopie angelegt. Die Sicherung bleibt ausschließlich im lokalen App-Ordner (%LocalAppData%\YFTimeTracker\Backups)." />
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="OneDrive-Ordner:" />
                                                        <Run Text="Über „Ordner wählen“ einen lokal synchronisierten OneDrive-Ordner auswählen. Die tägliche Sicherungsdatei wird zusätzlich dorthin kopiert, sobald OneDrive den Ordner synchronisiert." />
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="Google Drive-Ordner:" />
                                                        <Run Text="Wie OneDrive, aber mit einem lokal synchronisierten Ordner von Google Drive for Desktop." />
                                                    </TextBlock>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run FontWeight="SemiBold" Text="YFDatenbank:" />
                                                        <Run Text="Noch in Entwicklung (Demnächst) – aktuell ohne Funktion, kann aber schon ausgewählt werden." />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Die lokale Sicherung bleibt in jedem Fall die Grundlage für die Wiederherstellung." TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                    </FontIcon>
                                </StackPanel>
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Zusätzlich zur lokalen Sicherung kann die tägliche Sicherungsdatei in einen selbst gewählten Ordner kopiert werden." TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding BackupDestinationOptions}"
                                SelectedItem="{Binding SelectedBackupDestination, Mode=TwoWay}" />

                            <Grid ColumnSpacing="12" Visibility="{Binding ExternalFolderRowVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource YFMutedTextStyle}"
                                    Text="{Binding ExternalBackupFolderPathDisplay}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Command="{Binding ChooseBackupFolderCommand}" Style="{StaticResource YFOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                        <TextBlock Text="Ordner wählen" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border
                                Padding="10,8"
                                Background="{ThemeResource YFSurfaceBrush}"
                                CornerRadius="8"
                                Visibility="{Binding YfDatabasePreviewNoticeVisibility}">
                                <TextBlock
                                    Style="{StaticResource YFMutedTextStyle}"
                                    Text="YFDatenbank ist in Entwicklung und sichert aktuell noch nicht extern."
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource YFStrokeBrush}" />

                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="LOKALE SICHERUNGEN" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="YFTimeTracker sichert die Datenbank automatisch beim ersten Start des Tages und vor jeder Änderung am Datenbestand." TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                Style="{StaticResource YFMutedTextStyle}"
                                Text="Noch keine Sicherungen vorhanden."
                                Visibility="{Binding BackupsEmptyVisibility}" />

                            <ListView
                                x:Name="BackupList"
                                MaxHeight="212"
                                ItemsSource="{Binding Backups}"
                                SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{Binding BackupsVisibility}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Summary}" />
                                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding FileName}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource YFSurfaceBrush}"
                                                CornerRadius="6">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource YFMutedTextStyle}"
                                                    Text="{Binding KindLabel}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Button
                                Click="RestoreBackup_Click"
                                IsEnabled="{Binding CanRestoreSelectedBackup}"
                                Style="{StaticResource YFOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                    <TextBlock Text="Ausgewählte Sicherung wiederherstellen" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="UpdateSettingsCard" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Margin="0,0,44,0">
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="APP-UPDATES" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Neue Versionen sicher aus den öffentlichen GitHub-Releases laden" />
                            </StackPanel>
                            <Border Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#102B50" CornerRadius="10">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE777;" />
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Padding="9,5" Background="{ThemeResource YFListRowBackgroundHoverBrush}" CornerRadius="7">
                                        <TextBlock FontSize="11" Foreground="{StaticResource YFBlueBrush}" Text="{Binding CurrentAppVersionText}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="{Binding AvailableUpdateText}" />
                                </StackPanel>
                                <TextBlock Foreground="{ThemeResource YFTextBrush}" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                                <ProgressBar
                                    Height="5"
                                    Maximum="100"
                                    Value="{Binding UpdateProgress}"
                                    Visibility="{Binding UpdateProgressVisibility}" />
                                <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="Es wird kein GitHub-Token gespeichert oder mit der App ausgeliefert." TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" MinWidth="210" VerticalAlignment="Center" Spacing="10">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="CheckForUpdates_Click"
                                    IsEnabled="{Binding CanCheckForUpdates}"
                                    Style="{StaticResource YFOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE895;" />
                                        <TextBlock Text="Auf Updates prüfen" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="InstallUpdate_Click"
                                    Style="{StaticResource YFAccentButtonStyle}"
                                    Visibility="{Binding InstallUpdateVisibility}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE896;" />
                                        <TextBlock Text="Update installieren" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="DiagnosticsSettingsCard" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,14,0,0" Style="{StaticResource YFCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Margin="0,0,44,0">
                                <TextBlock Style="{StaticResource YFSectionTitleStyle}" Text="DIAGNOSE &amp; SUPPORT" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource YFMutedTextStyle}" Text="Version, Speicherorte und verständlicher Tracking-Verlauf" />
                            </StackPanel>
                            <Border Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#291B52" CornerRadius="10">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="#B18CFF" Glyph="&#xE90F;" />
                            </Border>
                        </Grid>

                        <Grid x:Name="DiagnosticsOverviewGrid" ColumnSpacing="24" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource YFSubtleCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource YFTextBrush}" Text="{Binding DiagnosticsVersionText}" />
                                        <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding DiagnosticsRuntimeText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="16" RowSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{StaticResource YFBlueBrush}" Text="Installation" />
                                    <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding DiagnosticsInstallDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Foreground="{StaticResource YFBlueBrush}" Text="Daten" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding DiagnosticsDataDirectory}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Foreground="{StaticResource YFBlueBrush}" Text="Logs" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding DiagnosticsLogDirectory}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="DiagnosticsActions" Grid.Column="1" MinWidth="235" VerticalAlignment="Center" Spacing="10">
                                <Button HorizontalAlignment="Stretch" Command="{Binding OpenLogDirectoryCommand}" Style="{StaticResource YFOutlineButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xED25;" />
                                        <TextBlock Text="Logordner öffnen" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource YFAccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                        <TextBlock Text="Diagnosebericht exportieren" />
                                    </StackPanel>
                                </Button>
                                <TextBlock MaxWidth="260" Style="{StaticResource YFMutedTextStyle}" Text="Enthält Systeminformationen, Tracking-Ereignisse und bis zu drei aktuelle Logs, aber keine Datenbank oder Sicherungen." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource YFStrokeBrush}" />

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Tracking-Ereignisse" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource YFMutedTextStyle}" Text="{Binding TrackingDiagnosticsSummaryText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Padding="10,6"
                                Command="{Binding ClearTrackingDiagnosticsCommand}"
                                Style="{StaticResource YFOutlineButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    <TextBlock FontSize="12" Text="Liste leeren" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView
                            MaxHeight="380"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource YFListViewItemStyle}"
                            ItemsSource="{Binding TrackingDiagnosticEvents}"
                            SelectionMode="None"
                            Visibility="{Binding TrackingDiagnosticsVisibility}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,9" ColumnSpacing="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{ThemeResource YFEmptyStatePanelBrush}" BorderBrush="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" BorderThickness="1" CornerRadius="9">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Glyph="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding TimeText}" />
                                            <TextBlock FontSize="9" Foreground="{Binding AccentColor, Converter={StaticResource HexColorBrushConverter}}" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="11" Foreground="{ThemeResource YFMutedBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Padding="18" Background="{ThemeResource YFEmptyStatePanelBrush}" CornerRadius="10" Visibility="{Binding TrackingDiagnosticsEmptyVisibility}">
                            <StackPanel HorizontalAlignment="Center" Spacing="7">
                                <FontIcon HorizontalAlignment="Center" FontSize="22" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE9D9;" />
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Noch keine Tracking-Ereignisse" />
                                <TextBlock MaxWidth="460" TextAlignment="Center" Style="{StaticResource YFMutedTextStyle}" Text="Starte oder beende ein Spiel. Erkennung, Zuordnung und Session-Verlauf erscheinen dann hier – ohne vollständige EXE-Pfade." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,10" Background="{ThemeResource YFStatusBarBrush}" BorderBrush="{ThemeResource YFStrokeBrush}" BorderThickness="1" CornerRadius="9">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="9">
                        <FontIcon FontSize="13" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE946;" />
                        <TextBlock Style="{StaticResource YFMutedTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button
                            Padding="10,6"
                            Command="{Binding OpenExportFolderCommand}"
                            IsEnabled="{Binding IsExportFolderAvailable}"
                            Style="{StaticResource YFOutlineButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="12" Glyph="&#xED25;" />
                                <TextBlock FontSize="12" Text="Ordner öffnen" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource YFGreenBrush}" Text="LOKALE SPEICHERUNG" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
