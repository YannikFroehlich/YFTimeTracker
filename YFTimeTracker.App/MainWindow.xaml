<Window
    x:Class="YFTimeTracker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:YFTimeTracker.App.Controls"
    xmlns:viewModels="using:YFTimeTracker.App.ViewModels"
    Title="YFTimeTracker">
    <Grid x:Name="RootGrid" Background="{ThemeResource YFBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Background="{ThemeResource YFNavigationBrush}">
            <StackPanel
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    Width="20"
                    Height="20"
                    Source="Assets/YFTimeTrackerLogo.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource YFMutedBrush}"
                    Text="YFTimeTracker" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AlwaysShowHeader="True"
            Background="{ThemeResource YFBackgroundBrush}"
            CompactModeThresholdWidth="860"
            ExpandedModeThresholdWidth="1180"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            ItemInvoked="Navigation_ItemInvoked"
            OpenPaneLength="272"
            PaneDisplayMode="Left"
            SelectionFollowsFocus="Disabled">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource YFNavigationColor}" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource YFNavigationColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource YFNavItemForegroundColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource YFNavItemForegroundHoverColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource YFNavItemForegroundHoverColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource YFNavItemForegroundSelectedColor}" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource YFNavItemForegroundSelectedColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource YFNavItemBackgroundSelectedColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource YFNavItemBackgroundSelectedHoverColor}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource YFNavItemBackgroundHoverColor}" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource YFBlueColor}" />
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Grid Height="78" Margin="12,2,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="42"
                        Height="42"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{ThemeResource YFNavigationBrush}"
                        CornerRadius="12">
                        <Image
                            Source="Assets/YFTimeTrackerLogo.png"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource YFTextBrush}"
                            Text="YFTimeTracker" />
                        <TextBlock
                            FontSize="10"
                            CharacterSpacing="80"
                            Foreground="{StaticResource YFBlueBrush}"
                            Text="LOCAL EDITION" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" />
                <NavigationViewItem Content="Bibliothek" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sessions" Tag="sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Statistiken" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Jahresrückblick" Tag="year-review">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Einstellungen" Icon="Setting" Tag="settings" />
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="14,8,14,14"
                    Padding="16"
                    Background="{ThemeResource YFTrackingCardGradientBrush}"
                    BorderBrush="{ThemeResource YFStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid MinHeight="152">
                        <Ellipse
                            Width="120"
                            Height="120"
                            Margin="0,0,-58,-62"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Fill="#253BFF"
                            Opacity="0.14" />
                        <Ellipse
                            Width="72"
                            Height="72"
                            Margin="0,0,4,-36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Stroke="#9A4EFF"
                            StrokeThickness="1"
                            Opacity="0.65" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource YFGreenBrush}" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource YFGreenBrush}"
                                    Text="{Binding StatusText}" />
                            </StackPanel>
                            <TextBlock
                                MaxWidth="202"
                                Style="{StaticResource YFMutedTextStyle}"
                                Text="{Binding StatusDetailText}"
                                TextWrapping="Wrap" />
                            <Border
                                Margin="0,8,0,0"
                                Padding="10,6"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource YFOutlineButtonBackgroundBrush}"
                                CornerRadius="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Foreground="{StaticResource YFBlueBrush}" Glyph="&#xE9CE;" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource YFTextBrush}" Text="LOKAL &amp; PRIVAT" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.Header>
                <Grid Height="78" Padding="24,12,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="GlobalSearchBox"
                        MaxWidth="620"
                        Height="46"
                        AutomationProperties.Name="Globale Suche"
                        Background="{ThemeResource YFOutlineButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource YFStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Foreground="{ThemeResource YFTextBrush}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind GlobalSearchViewModel.Results, Mode=OneWay}"
                        PlaceholderText="Spiele, Sessions oder Statistiken suchen …"
                        QueryIcon="Find"
                        QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                        SuggestionChosen="GlobalSearchBox_SuggestionChosen"
                        TextChanged="GlobalSearchBox_TextChanged"
                        UpdateTextOnSelect="False"
                        VerticalContentAlignment="Center">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:GlobalSearchResultViewModel">
                                <Grid
                                    MinWidth="520"
                                    Padding="10,8"
                                    ColumnSpacing="12"
                                    Tag="{Binding}"
                                    Tapped="GlobalSearchResult_Tapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:GameIcon
                                        Width="32"
                                        Height="32"
                                        Background="#142845"
                                        FontFamily="{Binding IconFontFamily}"
                                        FontSize="13"
                                        Foreground="{StaticResource YFBlueBrush}"
                                        IconCornerRadius="8"
                                        IconPadding="3"
                                        IconPath="{Binding IconPath}"
                                        Initials="{Binding IconText}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource YFMutedBrush}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <Grid Width="42" Height="42" ToolTipService.ToolTip="Benachrichtigungen · Vorschau">
                            <Border Background="{ThemeResource YFOutlineButtonBackgroundBrush}" BorderBrush="{ThemeResource YFStrokeBrush}" BorderThickness="1" CornerRadius="21" />
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Glyph="&#xE7ED;" />
                            <Border
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource YFPurpleBrush}"
                                CornerRadius="9">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Text="·" />
                            </Border>
                        </Grid>
                        <Button
                            Padding="6,4,12,4"
                            Background="{ThemeResource YFOutlineButtonBackgroundBrush}"
                            BorderBrush="{ThemeResource YFStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            ToolTipService.ToolTip="Profil bearbeiten">
                            <Button.Flyout>
                                <Flyout x:Name="ProfileFlyout" Opening="ProfileFlyout_Opening" Placement="Bottom">
                                    <StackPanel Width="260" Spacing="12">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Lokales Profil" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource YFMutedBrush}"
                                            Text="Name und Farbe werden ausschließlich lokal auf diesem Gerät gespeichert."
                                            TextWrapping="Wrap" />
                                        <TextBox
                                            x:Name="ProfileNameInput"
                                            Header="Anzeigename"
                                            MaxLength="40"
                                            PlaceholderText="Dein Name"
                                            Style="{StaticResource YFTextBoxStyle}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource YFMutedBrush}" Text="Akzentfarbe" />
                                            <StackPanel x:Name="ProfileSwatchPanel" Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Standard"
                                                    Background="{StaticResource YFLogoGradientBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Blau"
                                                    Background="{StaticResource YFBlueBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="#3182FF" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Cyan"
                                                    Background="{StaticResource YFCyanBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="#2CE5F3" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Lila"
                                                    Background="{StaticResource YFPurpleBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="#8A4DFF" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Grün"
                                                    Background="{StaticResource YFGreenBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="#29E7A4" />
                                                <Button
                                                    Width="28"
                                                    Height="28"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Padding="0"
                                                    AutomationProperties.Name="Rot"
                                                    Background="{StaticResource YFRedBrush}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="2"
                                                    Click="ProfileSwatch_Click"
                                                    CornerRadius="14"
                                                    Tag="#FF5368" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="ProfileSaveButton_Click"
                                            Content="Speichern"
                                            Style="{StaticResource YFAccentButtonStyle}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border x:Name="ProfileAvatarBorder" Width="34" Height="34" Background="{StaticResource YFLogoGradientBrush}" CornerRadius="17">
                                    <TextBlock x:Name="ProfileInitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="YF" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock x:Name="ProfileNameText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource YFTextBrush}" Text="Lokales Profil" />
                                    <TextBlock FontSize="9" Foreground="{ThemeResource YFMutedBrush}" Text="Lokal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>

            <Frame x:Name="ContentFrame" Background="{ThemeResource YFBackgroundBrush}" />
        </NavigationView>
    </Grid>
</Window>
